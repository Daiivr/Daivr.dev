# Copia este archivo a ".env" y rellena los valores

PORT=4000

# Genera uno random largo
JWT_SECRET=pon_aqui_un_secreto_largo

# Crea una aplicación en Discord Developer Portal:
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret

# URL del callback (debe coincidir con la configurada en Discord)
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# (Opcional) Bot Token para poder resolver el avatar actual de los usuarios en comentarios
# Si no lo pones, la web usará el avatar guardado y un fallback para evitar imágenes rotas.
DISCORD_BOT_TOKEN=tu_bot_token


STEAMGRID_API_KEY=tu_steamgrid_api_key

# Steam Web API for game shelf playtime
# Get an API key from Steam and use the SteamID64 of the account whose hours
# should appear on the game shelf.
STEAM_API_KEY=tu_steam_web_api_key
STEAM_ID64=tu_steamid64

ADMIN_IDS=tu_discord_id

# JSON storage directory. For Render persistent disks, mount the disk at /var/data
# and set DATA_DIR=/var/data so leaderboards/streaks/settings survive redeploys.
# DATA_DIR=/var/data
# DRIVE_MAD_DATA_DIR=/var/data
# STREAK_DATA_DIR=/var/data

# VirusTotal: used by /api/tradedex/scan to gate the TradeDex download.
# Get a key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=tu_virustotal_api_key
# Optional: override the repo the scanner watches (default: Daiivr/TradeDex)
# TRADEDEX_REPO=Daiivr/TradeDex
# Optional: GitHub token to bump release-API rate limits
# GITHUB_TOKEN=ghp_...
# Optional: where to cache scan results
# TRADEDEX_DATA_DIR=/var/data
